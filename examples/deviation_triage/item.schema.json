{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Deviation triage proposal",
  "description": "An AI agent's proposed triage of a manufacturing deviation, as shown to the reviewer. Synthetic demo only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "deviation_id",
    "occurred_on",
    "product",
    "lot_number",
    "process_step",
    "description",
    "classification",
    "classification_rationale",
    "root_cause",
    "immediate_actions",
    "capa_required"
  ],
  "properties": {
    "deviation_id": { "type": "string", "pattern": "^DEV-[0-9]{4}-[0-9]{4}$" },
    "occurred_on": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "product": { "type": "string", "minLength": 1 },
    "lot_number": { "type": "string", "pattern": "^LOT-[A-Z][0-9]{5}$" },
    "process_step": {
      "type": "string",
      "enum": ["dispensing", "granulation", "compression", "coating", "filling", "packaging", "storage", "laboratory"]
    },
    "description": { "type": "string", "minLength": 1 },
    "classification": { "type": "string", "enum": ["minor", "major", "critical"] },
    "classification_rationale": { "type": "string", "minLength": 1 },
    "root_cause": { "type": "string", "minLength": 1 },
    "immediate_actions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "capa_required": { "type": "boolean" }
  }
}
